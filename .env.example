# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Postgres (Supabase). Use the Session-pooler URI from Supabase → Connect.
# Percent-encode any special characters in the password, or use an alphanumeric one.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Storage — where captured photos / cropped diagrams are uploaded.
# Project Settings -> API for both values. SUPABASE_SERVICE_ROLE_KEY is
# server-side only — never expose it to the frontend. Needs a PUBLIC bucket
# named "media" (Storage -> New bucket -> toggle Public), created once by hand.
# Without these, uploads fall back to local disk (fine for dev, ephemeral on
# most hosts).
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Browser origins allowed to call the API (comma-separated).
# In production set your deployed frontend URL, e.g. https://desknotes.pages.dev
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Single account (defaults admin/admin if unset)
DESKNOTES_USER=admin
DESKNOTES_PASSWORD=admin

# JWT signing secret — set to a long random string in production
DESKNOTES_SECRET=change-me-to-a-long-random-string

# Transcription provider — precedence: OpenAI > Hugging Face > stub.
# OpenAI (preferred): paste your key here.
OPENAI_API_KEY=
DESKNOTES_OPENAI_MODEL=gpt-4o

# Hugging Face fallback (used only if OPENAI_API_KEY is empty).
HF_TOKEN=
DESKNOTES_HF_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
