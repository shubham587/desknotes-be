# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Single account (defaults admin/admin if unset)
DESKNOTES_USER=admin
DESKNOTES_PASSWORD=admin

# JWT signing secret — set to a long random string in production
DESKNOTES_SECRET=change-me-to-a-long-random-string

# Transcription provider — precedence: OpenAI > Hugging Face > stub.
# OpenAI (preferred): paste your key here.
OPENAI_API_KEY=
DESKNOTES_OPENAI_MODEL=gpt-4o

# Hugging Face fallback (used only if OPENAI_API_KEY is empty).
HF_TOKEN=
DESKNOTES_HF_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
